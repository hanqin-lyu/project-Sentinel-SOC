# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout

# ---------------------------------------------------------------------------
# Terraform (additions)
# Keep .terraform.lock.hcl in version control so provider versions are pinned.
# ---------------------------------------------------------------------------
*.tfplan
tfplan
planout

# ---------------------------------------------------------------------------
# Secrets and credentials (honeypot, Logic Apps, threat-intel APIs)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.ppk
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.kdbx
secrets.*
*.secret
*.secrets.json
# Local parameter files that may hold API keys, webhook URLs or subscription IDs
*.parameters.local.json
*.local.json
local.settings.json
# Teams / Logic Apps webhook URLs and API connection exports
webhook-urls.*
api-connections.*.json

# ---------------------------------------------------------------------------
# Azure CLI / tooling state
# ---------------------------------------------------------------------------
.azure/
azureProfile.json
accessTokens.json
msal_token_cache.*

# ---------------------------------------------------------------------------
# Evidence and exports
# Redacted screenshots go in docs/evidence/. Raw exports can contain real
# attacker data, subscription/tenant IDs or tokens and must not be committed.
# ---------------------------------------------------------------------------
evidence/raw/
docs/evidence/raw/
exports/
*.har
*.pcap
*.pcapng
*.evtx
auth.log*
audit.log*
syslog*
*.log
# Raw query result dumps (keep curated KQL in detections/)
*.results.csv
*.results.json

# ---------------------------------------------------------------------------
# Scripts and runtimes
# ---------------------------------------------------------------------------
node_modules/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# ---------------------------------------------------------------------------
# Editors, OS and Office
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
# Word / Excel / PowerPoint lock and temp files
~$*
.~lock.*#
# Local assistant settings (project deny rules, if added, stay tracked)
.claude/settings.local.json
