# Copy to terraform.tfvars (git-ignored) and fill in.
subscription_id      = "00000000-0000-0000-0000-000000000000"
admin_ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

# Your public IP as /32 for admin SSH on admin_ssh_port. Empty = no admin rule.
management_source_cidr = "203.0.113.10/32"

