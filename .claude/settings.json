{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git add)",
      "Bash(git add *)",
      "Bash(git reset)",
      "Bash(git reset *)",
      "Bash(git clean)",
      "Bash(git clean *)",
      "Bash(git rebase)",
      "Bash(git rebase *)",
      "Bash(terraform apply)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy)",
      "Bash(terraform destroy *)",
      "Bash(terraform import)",
      "Bash(terraform import *)",
      "Bash(terraform state)",
      "Bash(terraform state *)",
      "Bash(terraform plan)",
      "Bash(terraform plan *)",
      "Bash(az login)",
      "Bash(az login *)",
      "Bash(az * create *)",
      "Bash(az * update *)",
      "Bash(az * delete *)",
      "Read(./**/terraform.tfvars)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.parameters.local.json)",
      "Read(./**/*.pem)",
      "Edit(./**/terraform.tfvars)",
      "Edit(./**/*.tfstate)",
      "Edit(./**/*.parameters.local.json)"
    ]
  }
}
